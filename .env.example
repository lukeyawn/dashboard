# Copy to .env and fill in. Never commit .env (DESIGN §2).
# Generate each token with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# For you: browsers (/manage, the dashboard) and Claude's MCP server
API_TOKEN=
# For the kiosk Pi only
KIOSK_TOKEN=

# Google Calendar settings → "Secret address in iCal format". Also a password.
GCAL_ICS_URL=

# The dashboard's time zone: what "today" means for streaks, night hours and deadlines.
# Must match the kiosk's time zone (DESIGN §11).
TZ=America/Chicago

# Development: Vite proxies /api to this port
PORT=3001
# DATABASE=data/dashboard.db

# The claude.ai connector (docs/CONNECTOR.md, vm/CONNECTOR.md). Off unless
# PUBLIC_URL is set. vm/oauth-client.sh fills in the rest; the secrets are
# passwords too. PUBLIC_URL has no port (claude.ai only connects to 443);
# TAILNET_URL is the dashboard itself, on the same host.
# PUBLIC_URL=https://dashboard.<tailnet>.ts.net
# TAILNET_URL=https://dashboard.<tailnet>.ts.net:8443
# PUBLIC_PORT=3002
# OAUTH_CHAT_CLIENT_ID=
# OAUTH_CHAT_CLIENT_SECRET=
# OAUTH_REFRESH_KEY=
